<div class="container mx-auto max-w-lg px-4 py-8">
  <h2 class="text-2xl font-semibold text-gray-900">Forgot your password?</h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "mt-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="field my-2">
      <%= f.label :email, class: "mb-1 block text-sm font-medium text-gray-700" %>
      <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            class: "mt-2 w-full rounded-md border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>

    <div class="actions">
      <%= f.submit "Send me reset password instructions",
            class: "px-8 py-2 my-4 bg-gray-300 hover:bg-blue-200 rounded" %>
    </div>
  <% end %>

  <div class="mt-4">
    <%= render "devise/shared/links" %>
  </div>
</div>
