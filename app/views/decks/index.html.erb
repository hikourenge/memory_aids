<div class="mx-auto max-w-6xl px-4 pt-6">
    <h2 class = "text-2xl" ><%= t(".title") %></h2>
    <!-- 検索フォーム -->
    <div class="mb-6 my-2">
        <%= search_form_for @q, url: decks_path, method: :get do |f| %>
        <div class="flex gap-2 items-center">
            <%= f.search_field :title_cont,
                placeholder: "タイトル検索",
                class: "w-full rounded-md border border-gray-300 px-3 py-2 text-sm" %>

            <%= f.submit "検索",
                class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white" %>
  </div>
<% end %>
  </div>
    <% if @tag.present? %>
        <div class="mb-4 flex items-center justify-between">
        <p class="text-sm text-gray-700">
            <span class="font-semibold">「<%= @tag.name %>」</span>
            で絞り込み中
        </p>
        <%= link_to "タグでの絞り込みを解除", decks_path,
                class: "inline-flex items-center rounded-md border border-gray-300 bg-white px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50" %>
        </div>
    <% end %>

  <!-- デッキ一覧 -->
  <div>
    <% if @decks.present? %>
        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            <%= render partial: 'deck', collection: @decks %>
        </div>
    <% else %>
        <div class="mb-3"><%= t(".no_decks") %></div>
    <% end %>
</div>

    <div class = "mt-4" >
    <%= paginate @decks, theme: 'tailwind' %>
    </div>
    </div>
  </div>
</div>