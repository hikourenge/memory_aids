<div class="overflow-hidden border border-gray-200 rounded-lg">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%=t(".deck_image") %></th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%=t(".title") %></th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%=t(".description") %></th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%=t(".tag") %></th>
              <th scope="col" class="px-6 py-3 text-start text-xs font-medium text-gray-500 uppercase"><%=t(".status") %></th>
              <th scope="col" class="px-6 py-3 text-end text-xs font-medium text-gray-500 uppercase"><%=t(".edit") %>/<%=t(".delete") %></th>
              <th scope="col" class="px-6 py-3 text-end text-xs font-medium text-gray-500 uppercase"><%=t(".cards_index") %></th>
            </tr>
          </thead>

          <tbody class="divide-y divide-gray-200 bg-white">
            <% @decks.each do |deck| %>
              <tr class="hover:bg-gray-50">
                <!-- サムネイル -->
                <td class="px-6 py-4 whitespace-nowrap">
                  <%= image_tag deck.deck_image_url, alt: deck.title, class: "h-12 w-20 object-cover rounded", width:"300", height: "200" %>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-800">
                  <%=  link_to deck.title, deck_path(deck), class: "hover:underline" %>
                </td>

                <td class="px-6 py-4 text-sm text-gray-800">
                  <%= link_to truncate(deck.description, length: 50), deck_path(deck), class: "hover:underline" %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-800">
                  <% if deck.tags.any? %>
                    <div class="flex flex-wrap gap-1">
                      <% deck.tags.each do |tag| %>
                        <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">
                          <%= tag.name %>
                        </span>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-xs text-gray-400"><%= t(".no_tags") %></span>
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm">
                  <% if deck.status_published? %>
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-green-100 text-green-800">
                      <%= t(".published") %>
                    </span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-800">
                      <%= t(".hidden") %>
                    </span>
                  <% end %>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                  <%= link_to edit_deck_path(deck), 
                    class: "inline-flex items-center rounded-md border border-gray-300 px-3 py-1.5 text-xs font-medium text-gray-700 hover:bg-gray-50" do %>
                    <%= heroicon "pencil-square", variant: "solid", class: "mr-1 h-4 w-4 text-gray-600" %>
                    <%= t(".edit") %>
                   <% end %>

                  <%= link_to deck_path(deck), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" },
                    class: "inline-flex items-center rounded-md border border-red-300 px-3 py-1.5 text-xs font-medium text-red-600 hover:bg-red-50" do %>
                    <%= heroicon "trash", variant: "solid", class: "mr-1 h-4 w-4 text-red-600" %>
                    <%= t(".delete") %>
                   <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-end text-sm font-medium">
                  <%= link_to t(".cards_index"), deck_cards_path(deck),
                  class: "inline-flex items-center rounded-lg bg-gray-100 px-3 py-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-200" %>
                </td>
              </tr>
            <% end %>

            <% if @decks.empty? %>
              <tr>
                <td colspan="6" class="px-6 py-4 text-sm text-gray-500">
                  <%= t(".no_decks") %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>